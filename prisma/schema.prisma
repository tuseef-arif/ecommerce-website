// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  SELF_COLLECTION
  COD
}

enum ProductDiscountType {
  NONE
  PERCENT
  FIXED
}

/** Store-wide cart / checkout discount rules (admin-managed coupon-style rows). */
enum DiscountType {
  FIXED
  PERCENTAGE
}

model Discount {
  id                String       @id @default(cuid())
  name              String
  /** Normalized uppercase code for uniqueness and lookup. */
  code              String       @unique
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  startAt           DateTime?
  endAt             DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([isActive])
  @@index([discountType])
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  password             String
  firstName            String?
  lastName             String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  /** Public URL path, e.g. `/uploads/profile-images/<id>.jpg` — stored under `public/`. */
  profileImagePath     String?
  role                 UserRole             @default(USER)
  status               UserStatus           @default(ACTIVE)
  autoCreated          Boolean              @default(false)
  cartItems            CartItem[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([role])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Pending registration: OTP sent to email; user row is created only after successful verify. */
model SignupOtpChallenge {
  id           String   @id @default(cuid())
  email        String   @unique
  codeHash     String
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  address      String
  city         String
  country      String
  expiresAt    DateTime
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  products      Product[]
  saleOverrides CategorySaleOverride[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([name])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  brand       String
  model       String
  productType String      @default("general")
  description String?
  imagePath   String?
  specs          Json?
  keyFeatures    Json?
  colorOptions   Json?
  /** Admin-managed list of available storage variants (e.g. ["64 GB", "128 GB"]). */
  storageOptions Json?
  price       Decimal     @db.Decimal(10, 2)
  discountType ProductDiscountType @default(NONE)
  discountValue Decimal?   @db.Decimal(10, 2)
  isDiscountActive Boolean @default(false)
  stock       Int
  isActive    Boolean     @default(true)
  isOnSale    Boolean     @default(false)
  isNewArrival Boolean    @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  heroSlides  HeroSlideProduct[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, isActive])
  @@index([name])
  @@index([brand])
  @@index([model])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  status         OrderStatus   @default(PENDING)
  /** Payment method chosen at checkout. Defaults to COD so legacy rows stay safe. */
  paymentMethod  PaymentMethod @default(COD)
  subtotal       Decimal       @db.Decimal(10, 2)
  /** Savings from product-level pricing (catalog vs effective line prices). */
  discountAmount Decimal       @db.Decimal(10, 2)
  /** Uppercase cart voucher code applied at checkout, if any. */
  voucherCode          String?
  /** Snapshot of the discount display name at checkout (for admin history). */
  voucherName          String?
  /** Extra reduction from cart voucher (fixed or percentage rule). */
  voucherDiscountAmount Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  shippedAt      DateTime?
  deliveredAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  productName       String
  unitPrice         Decimal  @db.Decimal(10, 2)
  discountPercent   Decimal  @db.Decimal(5, 2)
  discountedPrice   Decimal  @db.Decimal(10, 2)
  /** Snapshot of the chosen color variant (e.g. "White"); null when the
   * product had no color options at sale time. */
  selectedColor     String?
  /** Snapshot of the chosen storage variant (e.g. "12 GB"); null when the
   * product had no storage options at sale time. */
  selectedStorage   String?
  /** Per-unit upcharge from the chosen color variant. Defaults to 0 so legacy
   * rows (before this column existed) keep arithmetic stable. */
  colorPriceDelta   Decimal  @default(0) @db.Decimal(10, 2)
  /** Per-unit upcharge from the chosen storage variant. Defaults to 0 for
   * legacy rows. */
  storagePriceDelta Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal         Decimal  @db.Decimal(10, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

/** Storefront hero banner slide; admin-managed via `/dashboard/banner`. */
model HeroSlide {
  id        String             @id @default(cuid())
  /** Display heading on the slide (e.g. product line name). */
  name      String
  /** Public URL/path of the hero image (local `/uploads/hero/...` or full Vercel Blob URL). */
  imagePath String?
  /** Descriptive alt text used by `next/image`. */
  imageAlt  String
  /** Bullet lines shown next to the image; stored as a JSON array of strings. */
  specs     Json
  /** Lower values render first in the rotator. Ties broken by `createdAt` ASC. */
  sortOrder Int                @default(0)
  /** Hidden from the storefront when false (still editable in admin). */
  isActive  Boolean            @default(true)
  /** Products surfaced when the banner is clicked. Ordered by `position`. */
  products  HeroSlideProduct[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([isActive, sortOrder])
}

/**
 * Join row linking a `HeroSlide` to a `Product`. `position` drives display
 * order on the curated `/banner/[slideId]` page. Cascading deletes mean
 * removing either side automatically prunes the link.
 */
model HeroSlideProduct {
  slideId   String
  productId String
  position  Int       @default(0)
  slide     HeroSlide @relation(fields: [slideId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([slideId, productId])
  @@index([slideId, position])
  @@index([productId])
}

model GlobalSetting {
  id                 Int      @id @default(1)
  globalSaleEnabled  Boolean  @default(false)
  globalSalePercent  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CategorySaleOverride {
  id          String   @id @default(cuid())
  categoryId  String
  isEnabled   Boolean  @default(false)
  percent     Decimal  @default(0) @db.Decimal(5, 2)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId])
  @@index([isEnabled])
}
