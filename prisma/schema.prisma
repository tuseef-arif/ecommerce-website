// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
}

enum PaymentMethod {
  BANK_TRANSFER
  SELF_COLLECTION
  COD
}

enum ProductDiscountType {
  NONE
  PERCENT
  FIXED
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  password             String
  firstName            String?
  lastName             String?
  phone                String?
  address              String?
  city                 String?
  country              String?
  /** Public URL path, e.g. `/uploads/profile-images/<id>.jpg` — stored under `public/`. */
  profileImagePath     String?
  role                 UserRole             @default(USER)
  status               UserStatus           @default(ACTIVE)
  autoCreated          Boolean              @default(false)
  cartItems            CartItem[]
  orders               Order[]
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([role])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Pending registration: OTP sent to email; user row is created only after successful verify. */
model SignupOtpChallenge {
  id           String   @id @default(cuid())
  email        String   @unique
  codeHash     String
  passwordHash String
  firstName    String
  lastName     String
  phone        String
  address      String
  city         String
  country      String
  expiresAt    DateTime
  attemptCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Category {
  id            String                 @id @default(cuid())
  name          String
  slug          String                 @unique
  products      Product[]
  saleOverrides CategorySaleOverride[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([name])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  brand       String
  model       String
  productType String      @default("general")
  description String?
  imagePath   String?
  specs          Json?
  keyFeatures    Json?
  colorOptions   Json?
  /** Admin-managed list of available storage variants (e.g. ["64 GB", "128 GB"]). */
  storageOptions Json?
  price       Decimal     @db.Decimal(10, 2)
  discountType ProductDiscountType @default(NONE)
  discountValue Decimal?   @db.Decimal(10, 2)
  isDiscountActive Boolean @default(false)
  stock       Int
  isActive    Boolean     @default(true)
  isOnSale    Boolean     @default(false)
  isNewArrival Boolean    @default(false)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId, isActive])
  @@index([name])
  @@index([brand])
  @@index([model])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model Order {
  id             String        @id @default(cuid())
  userId         String
  status         OrderStatus   @default(PENDING)
  /** Payment method chosen at checkout. Defaults to COD so legacy rows stay safe. */
  paymentMethod  PaymentMethod @default(COD)
  subtotal       Decimal       @db.Decimal(10, 2)
  discountAmount Decimal       @db.Decimal(10, 2)
  totalAmount    Decimal       @db.Decimal(10, 2)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items          OrderItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  shippedAt      DateTime?
  deliveredAt    DateTime?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentMethod])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  productId         String
  quantity          Int
  productName       String
  unitPrice         Decimal  @db.Decimal(10, 2)
  discountPercent   Decimal  @db.Decimal(5, 2)
  discountedPrice   Decimal  @db.Decimal(10, 2)
  /** Snapshot of the chosen color variant (e.g. "White"); null when the
   * product had no color options at sale time. */
  selectedColor     String?
  /** Snapshot of the chosen storage variant (e.g. "12 GB"); null when the
   * product had no storage options at sale time. */
  selectedStorage   String?
  /** Per-unit upcharge from the chosen color variant. Defaults to 0 so legacy
   * rows (before this column existed) keep arithmetic stable. */
  colorPriceDelta   Decimal  @default(0) @db.Decimal(10, 2)
  /** Per-unit upcharge from the chosen storage variant. Defaults to 0 for
   * legacy rows. */
  storagePriceDelta Decimal  @default(0) @db.Decimal(10, 2)
  lineTotal         Decimal  @db.Decimal(10, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model GlobalSetting {
  id                 Int      @id @default(1)
  globalSaleEnabled  Boolean  @default(false)
  globalSalePercent  Decimal  @default(0) @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CategorySaleOverride {
  id          String   @id @default(cuid())
  categoryId  String
  isEnabled   Boolean  @default(false)
  percent     Decimal  @default(0) @db.Decimal(5, 2)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId])
  @@index([isEnabled])
}
